# ============================================================================
#  Your Interview —— 本地密钥配置(模板)
#
#  用法: cp .env.example .env, 再把下面的值换成你自己的真实密钥。
#  .env 已被 .gitignore 排除, 绝不会提交到仓库。
#
#  docker compose 会自动读取仓库根的 .env 文件。
# ============================================================================

# --- 录音/音频文件在本机(Mac)的存放目录 ------------------------------------
# 默认:仓库同级的 recordings/(与仓库平级,不会被误提交到 GitHub)。
# 也可以直接在"我的账户 → 偏好设置 → 本机存储路径"里改(改完按页面提示挂载即可)。
# 例:RECORDINGS_HOST_DIR=/Users/你的用户名/Documents/your-interview/recordings
# RECORDINGS_HOST_DIR=../recordings

# --- Azure Speech(语音转写)-------------------------------------------------
# Azure 门户 → 你的 Speech 资源 → 密钥和终结点 → 密钥 1
AZURE_SPEECH_KEY=REPLACE_WITH_YOUR_AZURE_SPEECH_KEY

# Speech 资源所在区域,例如 canadacentral / eastus / eastasia
AZURE_SPEECH_REGION=canadacentral

# --- 服务账号(Analysis.Worker 回写结果时登录 Identity 用)--------------------
# 需与 Services.Identity 播种的服务账号一致
SERVICE_ACCOUNT_EMAIL=service.analysis@your-interview.local
SERVICE_ACCOUNT_PASSWORD=REPLACE_WITH_SERVICE_ACCOUNT_PASSWORD

# --- JWT 签名密钥(六个服务必须用同一个值)--------------------------------------
# Identity 用它签令牌,其余服务用它验令牌。至少 32 字符。
# 生成一个随机值: openssl rand -base64 48
JWT_SIGNING_KEY=REPLACE_WITH_SIGNING_KEY_AT_LEAST_32_CHARS

# --- 管理员密码(仅 Identity 首次播种时用一次)--------------------------------
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# --- 演示数据密码(Identity 播种 demo@your-interview.local 与 12 个示例用户用)-----
# 留空则跳过演示数据播种(不影响正常功能)
DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD

# --- 测试用账号密码(供 tools/contract-check.sh 与 tools/e2e.sh 自动登录)--------
# 留空则脚本会提示你显式传入。通常与 ADMIN_PASSWORD 一致。
VIEWER_EMAIL=viewer@your-interview.local
VIEWER_PASSWORD=REPLACE_WITH_VIEWER_PASSWORD
