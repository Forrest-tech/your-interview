{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5100",
      "http://127.0.0.1:4200"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-webhooks": {
        "ClusterId": "identity",
        "Order": 0,
        "Match": {
          "Path": "/api/webhooks/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/webhooks/{**catch-all}"
          }
        ]
      },
      "identity": {
        "ClusterId": "identity",
        "Order": 1,
        "Match": {
          "Path": "/api/{**catch-all}",
          "QueryParameters": []
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "identity-auth": {
        "ClusterId": "identity",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "jobs": {
        "ClusterId": "jobs",
        "Order": 1,
        "Match": {
          "Path": "/api/jobs/{**catch-all}"
        }
      },
      "interviews": {
        "ClusterId": "interviews",
        "Order": 1,
        "Match": {
          "Path": "/api/interviews/{**catch-all}"
        }
      },
      "knowledge": {
        "ClusterId": "knowledge",
        "Order": 1,
        "Match": {
          "Path": "/api/knowledge/{**catch-all}"
        }
      },
      "assessment": {
        "ClusterId": "assessment",
        "Order": 1,
        "Match": {
          "Path": "/api/assessment/{**catch-all}"
        }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Order": 1,
        "Match": {
          "Path": "/api/analytics/{**catch-all}"
        }
      },
      "admin": {
        "ClusterId": "identity",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "aigateway": {
        "ClusterId": "aigateway",
        "Order": 1,
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      },
      "ocr": {
        "ClusterId": "ocr",
        "Order": 1,
        "Match": {
          "Path": "/api/ocr/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      }
    },
    "HealthChecks": {
      "_comment": "只探这里列出的下游集群。EnabledClusters 写逗号分隔的字符串(推荐),或用环境变量 ReverseProxy__HealthChecks__EnabledClusters 注入(环境变量优先)。本默认清单 = 7 个业务集群,OCR 排除在外:网关转发业务 API 不依赖 OCR(它重、PaddleOCR),OCR 自身可用性由票 92 金标准集守,不由网关 liveness 判定。整节留空或删除 = 探全部(默认)。注意:docker-compose.hybrid.yml:76 用环境变量覆盖了一份 4 集群清单,那是 hybrid 模式(只起 4 个服务)的有意覆盖,仅在 hybrid 模式下生效,两份清单按模式分工、不打架(见 docs/fix-program/evidence-94/DECISION-94.md)。",
      "EnabledClusters": "identity,jobs,interviews,knowledge,assessment,analytics,aigateway"
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5262/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "jobs": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5263/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "interviews": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5264/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "knowledge": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5265/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "assessment": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5266/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "analytics": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5267/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "aigateway": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5268/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      },
      "ocr": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5300/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Path": "/health/live"
          }
        }
      }
    }
  }
}
